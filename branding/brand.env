# ============================================================
#  MDM Smart OS – impostazioni del marchio
# ============================================================

# Nome del prodotto. DEVE restare di 14 caratteri, come "Home Assistant",
# perché viene sostituito anche dentro programmi già compilati (CLI "ha").
BRAND_NAME="MDM Smart Home"

# Nome del sistema operativo (avvio, os-release, pagina Informazioni)
BRAND_OS="MDM Smart OS"

# Nome di rete del NUC al primo avvio (http://mdm-smart.local:8123)
BRAND_HOSTNAME="mdm-smart"

# Indirizzo del canale aggiornamenti MDM (lasciare vuoto = automatico:
# https://<utente-github>.github.io/<nome-repo>/ ). Deve finire con "/".
VERSION_URL=""

# Macchina e architettura dei NUC
MACHINE="generic-x86-64"
ARCH="amd64"
OS_BOARD="generic_x86_64"
